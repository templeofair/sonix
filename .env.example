# Copy to .env and fill in the required values.
#   cp .env.example .env
# Never commit .env.

# ── Required ────────────────────────────────────────────────────────────────
# Signing secret for session cookies. Generate one: openssl rand -hex 32
# The app refuses to start without it. Never commit your real value.
SESSION_SECRET=

# ── First run only ──────────────────────────────────────────────────────────
# Creates the single login when the database has no users yet. There is no
# in-app registration. Remove these after the first successful start.
SEED_USERNAME=admin
SEED_PASSWORD=

# ── Ollama (AI extraction) ──────────────────────────────────────────────────
# Where Ollama listens. Inside Docker, host.docker.internal reaches the host.
# Examples: http://host.docker.internal:11434 · http://localhost:11434
# Also changeable at runtime under Settings.
# Page images and text are sent to this URL. If it is not on the same machine,
# your documents leave the host.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# One model tag is used for both page images (vision) and text tasks
# (summary, translation, date). Both must be pulled in Ollama first.
OLLAMA_VISION_MODEL=gemma3:latest
OLLAMA_TEXT_MODEL=gemma3:latest

# Per-request timeout, minutes. Raise on slow hardware.
OLLAMA_TIMEOUT_MINUTES=15
# Wall-clock budget for one whole document (all pages + text tasks), minutes.
EXTRACTION_JOB_TIMEOUT_MINUTES=60
# Concurrent document extractions. Keep low: each one loads a model.
EXTRACTION_MAX_CONCURRENT=1
# Max pages per letter (upload + PDF). Default 50.
DOCUMENT_MAX_PAGES=50
# pdftoppm timeout, seconds. Default 120.
PDF_CONVERT_TIMEOUT_SECONDS=120
# Text pipeline: v2 (page-wise translate + summary + date) or v1 (legacy).
EXTRACTION_PIPELINE=v2

# ── OCR (Tesseract, bundled in the image) ───────────────────────────────────
# Used only when a scan requests OCR instead of vision.
OCR_ENGINE=tesseract
OCR_LANG=deu+eng          # any installed Tesseract languages, e.g. eng
OCR_DPI=300               # 0 = estimate per page from pixel size
OCR_PSM=1                 # Tesseract page segmentation mode

# ── Network ─────────────────────────────────────────────────────────────────
SONIX_HTTP_PORT=9080      # host port → container 9080
SONIX_HTTPS_PORT=9443     # host port → container 9443 (self-signed)

# Extra names/addresses to include in the self-signed certificate, so phones
# on your LAN can use the camera without a certificate error.
# Use documentation-range examples only; replace with your own LAN values.
# TLS_EXTRA_IPS=192.0.2.10
# TLS_EXTRA_HOSTS=sonix.example

# ── Storage ─────────────────────────────────────────────────────────────────
DATA_DIR=/app/data        # SQLite + uploads + thumbnails + certs + inbox

# ── Optional: auto-import from a network scanner ─────────────────────────────
IMPORT_INBOX_ENABLED=false
IMPORT_AUTO_EXTRACT=true
# HP_SCAN_IP=192.0.2.20   # your scanner's IPv4
# HP_SCAN_LABEL=Sonix     # label shown on the printer panel
# HP_SCAN_HEALTH_PORT=3001
